# Network to run against: sandbox | testnet | mainnet (mainnet is read-only)
COUNTERSIGN_NETWORK=
# Account ID of the deployed registry contract
COUNTERSIGN_REGISTRY_ID=
# Account ID of the deployed vault contract
COUNTERSIGN_VAULT_ID=
# Agent function-call key (ed25519:...), scoped to the vault. Never commit.
COUNTERSIGN_AGENT_KEY=
# Owner variables do NOT belong in this file: the agent (SDK, MCP server) reads it, and the MCP
# server refuses to start if COUNTERSIGN_OWNER_KEY is here. Put them in a separate owner file passed
# with `countersign --owner-env <file>` (approve / deny / pause / unpause / status), or export them
# in the owner's own shell.
# COUNTERSIGN_OWNER_ID=
# COUNTERSIGN_OWNER_KEY=
# Optional: NearBlocks API key for higher rate limits
NEARBLOCKS_API_KEY=
# Attack suite on testnet only (pnpm attacks --network testnet): the account the scenario accounts live under
# (acme-corp.<root>, acme-c0rp.<root>, fresh-invoice.<root>, reported.<root>, unknown-payee.<root>)
COUNTERSIGN_ATTACK_ROOT=
