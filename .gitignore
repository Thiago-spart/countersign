.claude/skills/
.claude/settings.local.json

# Build output
node_modules/
dist/
target/
*.wasm
coverage/
.turbo/

# Runtime data
receipts.jsonl
.cache/
*.log
.DS_Store

# Prebuilt contracts are committed
!contracts/res/*.wasm

# Setup recovery keys (vault full-access key until the batch succeeds)
.countersign/

# Attack suite output (regenerated by pnpm attacks)
attacks/last-run.json
